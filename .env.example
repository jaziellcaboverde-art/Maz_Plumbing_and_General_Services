# Copy this file to .env.local and fill in your own test keys.
# Never commit .env.local. Only variables starting with NEXT_PUBLIC_ reach the browser.

NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase (Phase 2)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Brevo transactional email (Phase 2)
BREVO_API_KEY=
NOTIFICATION_FROM_EMAIL=
NOTIFICATION_REPLY_TO_EMAIL=
NOTIFICATION_FROM_NAME=MAZ Plumbing and General Services
NOTIFICATION_WORKER_SECRET=
NOTIFICATION_WORKER_URL=http://localhost:3000

# Geoapify Phase 4 (the public key is restricted by Geoapify account settings and used in map tiles)
GEOAPIFY_API_KEY=
NEXT_PUBLIC_GEOAPIFY_API_KEY=

# PayMongo test keys (Phase 9)
PAYMONGO_SECRET_KEY=
PAYMONGO_PUBLIC_KEY=
PAYMONGO_WEBHOOK_SECRET=
