# Copy this file to .env.local and fill in your own test keys.
# Never commit .env.local. Only variables starting with NEXT_PUBLIC_ reach the browser.

NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase (Phase 2)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Password for the offer-expiry worker (POST or GET /api/jobs/expire-offers with "Authorization: Bearer <value>"). Make up a long random value.
CRON_SECRET=

# Cloudflare Turnstile on log in and sign up (https://dash.cloudflare.com > Turnstile).
# Leave both empty to turn the check off. For local testing use Cloudflare's dummy keys:
# site 1x00000000000000000000AA and secret 1x0000000000000000000000000000000AA (always pass).
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Google sign in has no keys here. Turn it on in Supabase: Authentication > Sign In / Providers > Google,
# paste the Google OAuth client ID and secret there, and add these redirect URLs under
# Authentication > URL Configuration: {site url}/auth/confirm (production and http://localhost:3000/auth/confirm).

# Brevo transactional email (Phase 2)
BREVO_API_KEY=
NOTIFICATION_FROM_EMAIL=
NOTIFICATION_REPLY_TO_EMAIL=
NOTIFICATION_FROM_NAME=MAZ Plumbing and General Services
NOTIFICATION_WORKER_SECRET=
NOTIFICATION_WORKER_URL=http://localhost:3000

# Geoapify Phase 4 (the public key is restricted by Geoapify account settings and used in map tiles)
GEOAPIFY_API_KEY=
NEXT_PUBLIC_GEOAPIFY_API_KEY=

# PayMongo test keys (Phase 9). Leave all three empty to use the built-in test payment page. With a secret key set, the webhook URL in the PayMongo dashboard is https://YOUR-SITE/api/payments/webhook (events: checkout_session.payment.paid, payment.failed).
# Leave all three empty to use the built-in test payment page.
# With keys: add the webhook https://YOUR-SITE/api/payments/webhook in PayMongo (events checkout_session.payment.paid, payment.failed).
PAYMONGO_SECRET_KEY=
PAYMONGO_PUBLIC_KEY=
PAYMONGO_WEBHOOK_SECRET=
