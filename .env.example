# Copy this file to .env.local and fill in your own development/production keys.
# Never commit or share .env.local. Only variables starting with NEXT_PUBLIC_ reach the browser.

NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase (required for real login and account creation).
# Copy the Project URL and publishable key (or legacy anon key) from your Supabase dashboard.
# IMPORTANT: These blank values are NOT working demo credentials.
# After setting .env.local, run `npm run auth:check` and restart `npm run dev`.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
CRON_SECRET=

# Google reCAPTCHA v2 checkbox. Leave both empty to disable locally.
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=
RECAPTCHA_SECRET_KEY=

# Optional Cloudflare Turnstile fallback. Used when reCAPTCHA keys are not configured.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Brevo transactional email
BREVO_API_KEY=
NOTIFICATION_FROM_EMAIL=
NOTIFICATION_REPLY_TO_EMAIL=
NOTIFICATION_FROM_NAME=MAZ Plumbing and General Services
NOTIFICATION_WORKER_SECRET=
NOTIFICATION_WORKER_URL=http://localhost:3000

# Geoapify Phase 4 (required for the provider location map, address search and pin lookup).
# Paste your Geoapify key in BOTH fields; restrict the public key in the Geoapify dashboard.
# Guest map selection does not need Supabase, but sending applications still does.
GEOAPIFY_API_KEY=
NEXT_PUBLIC_GEOAPIFY_API_KEY=

# Payment integration values retained for legacy code paths. Do not expose secret keys to the browser.
PAYMONGO_SECRET_KEY=
PAYMONGO_PUBLIC_KEY=
PAYMONGO_WEBHOOK_SECRET=
